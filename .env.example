# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
#
# WARNING: every VITE_-prefixed variable is inlined into the production bundle
# and is therefore publicly readable in the browser. These are "not in the
# repository", NOT "secret". Anything that must stay genuinely secret (API
# keys, tokens) must NOT use the VITE_ prefix and must live on a server.

VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_INSTAGRAM_URL=
VITE_YOUTUBE_URL=
VITE_TIKTOK_URL=
